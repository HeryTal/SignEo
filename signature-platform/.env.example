# API
PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=signeo
DATABASE_USER=signeo
DATABASE_PASSWORD=replace-with-a-local-password
DATABASE_SSL=false

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth (create a Web application client in Google Cloud Console)
# Authorized redirect URI for local development: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Use a distinct long random secret in production.
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-long-random-secret

# Encrypts webhook secrets at rest. Use a separate long random value in production.
WEBHOOK_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# SMTP. When configured, invitations are sent at envelope delivery and reminders
# run every day at 09:00. Leave empty in local development to keep copyable links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Identity verification. Set IDENTITY_VERIFICATION_PROVIDER=stripe to create a
# Stripe VerificationSession for each user. The application synchronizes its
# state with Stripe when it is read; this webhook URL is optional in test mode:
# https://YOUR_API_HOST/auth/identity-verification/stripe-webhook.
IDENTITY_VERIFICATION_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Stripe Billing: create recurring Prices in Stripe, then copy their price_ IDs.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# Generic provider fallback. It calls POST /auth/identity-verification/callback
# with X-Identity-Signature.
IDENTITY_VERIFICATION_URL=
IDENTITY_VERIFICATION_WEBHOOK_SECRET=

# API rate limits (Redis keeps counters across API restarts)
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_PER_MINUTE=60

# Optional cryptographic PDF seal (PAdES detached signature).
# Keep the P12 certificate and its password outside Git; use a server-only path.
# This organizational certificate seal does not by itself provide an advanced or qualified signature.
SIGNING_P12_PATH=
SIGNING_P12_PASSWORD=
SIGNING_CERT_NAME=Signeo

# Production only: absolute persistent document directory inside the API container.
# UPLOAD_DIRECTORY=/data/uploads
# Disable schema synchronization locally when testing migrations.
# DATABASE_SYNCHRONIZE=false
# Number of trusted reverse proxy hops; set only for your actual topology.
# TRUST_PROXY_HOPS=1
# Public API URL used by the production Compose frontend build.
# PUBLIC_API_URL=https://api.example.com
# Frontend local/build override outside Compose.
# NEXT_PUBLIC_API_URL=http://localhost:3001
